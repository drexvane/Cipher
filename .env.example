# Copy to `.env` (gitignored) and fill in only the provider you use. Nothing in
# this repository holds a key, and none is needed to build or test the project.
# An already-exported variable always wins over `.env`.

# Anthropic is the default live provider when this variable is configured.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5.
# DTP_AGENT_MODEL=claude-sonnet-5

# NVIDIA NIM is explicit opt-in. Set all of these locally after rotating any key
# that was exposed. Never put an actual credential in this example or Git.
# DTP_AGENT_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# The dashboard password gate is deliberately not read from this file. To try it
# locally, export DTP_DASHBOARD_PASSWORD before launching the dashboard.
